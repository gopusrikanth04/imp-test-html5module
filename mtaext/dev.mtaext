_schema-version: "3.2"
ID: nshtml5module-dev

extends: nshtml5module

resources:

  - name: nshtml5module-destination-service
    parameters:
      service-name: nshtml5module-destination-service-dev

  - name: nshtml5module-uaa
    parameters:
      service-name: nshtml5module-xsuaa-service-dev
      config:
        xsappname: nshtml5module-dev

  - name: nshtml5module-repo-host
    parameters:
      service-name: nshtml5module-html5-service-dev

modules:
  - name: nshtml5module-destination-content
    parameters:
      content:
        instance:
          destinations:
            - Name: nshtml5module_html_repo_host
              ServiceInstanceName: nshtml5module-html5-service-dev
              ServiceKeyName: nshtml5module-repo-host-key
              sap.cloud.service: nshtml5module

            - Authentication: OAuth2UserTokenExchange
              Name: nshtml5module_uaa
              ServiceInstanceName: nshtml5module-xsuaa-service-dev
              ServiceKeyName: nshtml5module-uaa-key
              sap.cloud.service: nshtml5module